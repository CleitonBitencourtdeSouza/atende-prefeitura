// Planta do banco de dados (a "despensa").
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Um chamado aberto pelo cidadão.
model Chamado {
  id           Int      @id @default(autoincrement())
  titulo       String
  descricao    String
  categoria    String   @default("Outros")
  bairro       String   @default("Não informado")
  status       String   @default("Aberto") // Aberto | Em andamento | Resolvido
  resposta     String?  // Resposta do atendente (vazia até alguém responder)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("chamados")
}
